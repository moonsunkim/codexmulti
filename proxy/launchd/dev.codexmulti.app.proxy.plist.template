<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.codexmulti.app.proxy</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/node</string>
    <!-- Replace with /Users/USER/.local/bin/node when that is the pinned runtime. -->
    <string>/ABSOLUTE/INSTALL/src/server.mjs</string>
    <string>--config</string>
    <string>/Users/USER/.config/codexmulti/proxy.json</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/INSTALL</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>Umask</key><integer>63</integer>
  <key>EnvironmentVariables</key><dict>
    <key>NODE_ENV</key><string>production</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/USER/Library/Logs/CodexMulti/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/Library/Logs/CodexMulti/stderr.log</string>
</dict></plist>
